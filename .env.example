# Copy this file to ".env" to override the defaults of docker-compose.yml.
# Every variable is optional: without a .env the project runs with the defaults shown here.

# Host port where the API is published (inside the container it is always 8080)
HOST_SERVER_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=nexus_app_password

# JWT: use your own random value of at least 32 bytes outside coursework
JWT_SECRET=NEXUSMARKET_DEV_SECRET_CHANGE_ME_0123456789
JWT_EXPIRATION_MS=3600000

# Origin allowed by CORS (your frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Load the demo data on startup
SEED_ENABLED=true
